# ==============================================================
# TUMANZA - Environment Configuration Template
# Copy this file to .env on your VPS and fill in the real values.
# NEVER commit your actual .env file with secrets to Git.
# ==============================================================

# MongoDB Atlas connection string
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/<database>?retryWrites=true&w=majority

# Admin Dashboard credentials
ADMIN_USERNAME=admin
ADMIN_PASSWORD=your_secure_password_here

# Public canonical site URL (production)
SITE_URL=https://tumanza.com

# SMTP Email configuration (for order emails & newsletter)
# tumanza.com mail is hosted on Hostinger, so use smtp.hostinger.com.
# For Gmail instead, set EMAIL_HOST=smtp.gmail.com and use a Gmail App Password.
EMAIL_HOST=smtp.hostinger.com
EMAIL_PORT=465
EMAIL_SECURE=true
EMAIL_USER=info@tumanza.com
EMAIL_PASS=your_mailbox_password

# Server port (optional, defaults to 3000 if not specified)
PORT=3000
